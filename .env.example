# Copy to .env and fill in. Placeholders only - never commit real secrets.

# --- Database ---
POSTGRES_USER=agritrace
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_DB=agritrace
DATABASE_URL=postgresql://agritrace:change-me-dev-only@localhost:5432/agritrace?schema=public

# --- API ---
API_PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
CORS_ORIGIN=http://localhost:5173

# --- Blockchain ---
# BLOCKCHAIN_MODE: disabled | local | testnet
BLOCKCHAIN_MODE=disabled
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_CONTRACT_ADDRESS=
# Never put a real-funds key here. Local Hardhat keys only for development.
CHAIN_OPERATOR_PRIVATE_KEY=

# --- Evidence storage ---
# EVIDENCE_STORAGE: local | ipfs
EVIDENCE_STORAGE=local
LOCAL_EVIDENCE_DIR=./services/api/storage
IPFS_API_URL=
IPFS_API_TOKEN=

# --- Web ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Seed (development only; seed refuses NODE_ENV=production and non-local hosts) ---
SEED_DEMO_PASSWORD=Demo-Only-Password-1!

# --- API tuning ---
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Set true only when running behind a trusted reverse proxy
TRUST_PROXY=false
